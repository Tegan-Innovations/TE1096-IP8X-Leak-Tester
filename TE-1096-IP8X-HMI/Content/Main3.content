                  "    .addKeyframe('transform', 'translate(0px, 88px)', 1)",
                  "    .duration(2000);",
                  "    ",
                  "animation.registerEventHandler('animationend', function (event) {",
                  "    console.log('Animation ended: ' + event.animationName);",
                  "    var someControl = TcHmi.Controls.get('ProbeAndChamberAnimation');",
                  "    var t = [{",
                  "        \"transformType\": \"Translate\",",
                  "        \"x\": 0,",
                  "        \"xUnit\": \"px\",",
                  "        \"y\": 88,",
                  "        \"yUnit\": \"px\",",
                  "        \"z\": 0,",
                  "        \"zUnit\": \"px\",",
                  "    }",
                  "    ];",
                  " someControl.setTransform(t);",
                  "});",
                  "",
                  "",
                  "animation.run();"
