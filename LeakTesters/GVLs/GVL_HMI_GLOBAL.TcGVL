  <GVL Name="GVL_HMI_GLOBAL" Id="{c69d1b5f-68bd-4781-a35c-f9a036e43abc}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
	
	//User Log, Shut down, Quit HMI
	bQuitHmi						: BOOL;
