	aGeneralPassHeightTest			: ARRAY[1..5] OF BOOL;
	aGeneralFailHeightTest			: ARRAY[1..5] OF BOOL;
	
	
	anValueScaledHeightTest			: ARRAY[1..4] OF DINT;
	
	aSensorSetPointsHeightTest		: ARRAY[1..4] OF DINT;
