	uNewLeakProgID					: USINT;	
	bResetLeakGoodParts				: BOOL;
	bResetLeakBadParts				: BOOL;
	nLeakTestCycTime				: DINT;
	

	//Height Tester
	bHeightTestPass					: BOOL;
	bResetHeightGoodParts			: BOOL;
	bResetHeightFailParts			: BOOL;
	bManualHeightTrigger			: BOOL;
