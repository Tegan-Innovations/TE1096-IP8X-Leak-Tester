	bEventTextsSet					: BOOL;
	aEventFlags						: ARRAY [0..767] OF BOOL;		//All event states combined from master na stations
	aActiveEvents					: ARRAY [0..39] OF T_MaxSTring;	//Active events - connected to Alarm scree in HMI	
	stActiveEventsHMI				: ARRAY [0..39] OF ST_ActiveEventsHMI;
	
	sMessageToOperator				: WSTRING(200);
