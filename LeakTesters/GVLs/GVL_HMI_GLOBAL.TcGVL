	rdistanceresult					: ARRAY[1..3] OF REAL;


	nHeightMeasureStateValue		: ARRAY [1..4] OF DINT;
	bProbesPositionOk				: BOOL;
	

END_VAR
VAR_GLOBAL PERSISTENT
	stAlarmHistory				:ARRAY [00..250] OF ST_AlarmHistory;
	aEventLog					:ARRAY [0..250] OF T_MaxSTring;	//Event log - connected to alarm history in HMI	
