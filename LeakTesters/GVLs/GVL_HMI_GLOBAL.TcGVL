	bAutocycleFaultDialog			: BOOL;
	bManualModeOff					: ARRAY [0..4] OF BOOL;
	nGeneralCycTime					: DINT;

	
	
	// ------ Screen Info / Data -----------	
	sSystemDate					: STRING;
	sSystemTime					: STRING;
